{
  "devDependencies": {
    "baseline-browser-mapping": "2.10.20",
    "husky": "9.1.7",
    "knip": "6.5.0",
    "madge": "8.0.0",
    "only-allow": "1.2.2",
    "prettier": "3.8.3",
    "shellcheck": "4.1.0",
    "sherif": "1.11.1",
    "turbo": "2.9.6"
  },
  "engines": {
    "node": "24",
    "pnpm": "10.33.0"
  },
  "name": "@shared/monorepo",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@expo/dom-webview": "55.0.5"
    }
  },
  "private": true,
  "scripts": {
    "build": "turbo build",
